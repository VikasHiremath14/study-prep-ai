# =============================================================================
# StudyPrep.AI — Environment Configuration Template
# =============================================================================

# 1. LLM Provider Configuration (gemini, claude, mock)
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here

# 2. Database Configuration
# Local SQLite (Default fallback):
DATABASE_URL=sqlite:///./study_prep_ai.db
# For Supabase Cloud PostgreSQL:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. Supabase Cloud Configuration (Frontend & Backend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4. Application Settings
ENVIRONMENT=development
APP_PORT=8000
FRONTEND_URL=http://localhost:8080
