# =============================================================================
# StudyPrep.AI — Environment Configuration
# =============================================================================

# 1. LLM Provider Configuration (gemini, claude, mock)
LLM_PROVIDER=gemini
LLM_API_KEY=

# 2. Database Configuration
# For Local SQLite (Default fallback):
DATABASE_URL=sqlite:///./study_prep_ai.db
# For Supabase Cloud PostgreSQL (Uncomment and replace with your Supabase DB URI):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. Supabase Cloud Configuration (Frontend & Backend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. Application Settings
ENVIRONMENT=development
APP_PORT=8000
FRONTEND_URL=http://localhost:8080
